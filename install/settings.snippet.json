{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git submodule update --init --depth 1 .gtd/kit >/dev/null 2>&1 || true; g=\"$CLAUDE_PROJECT_DIR/.gtd/kit/tools/agent_guard.py\"; [ -f \"$g\" ] && python3 \"$g\" --claude-hook || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*__(create_pull_request|create_or_update_file|delete_file|push_files)",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/.gtd/kit/tools/agent_guard.py\"; [ -f \"$g\" ] && python3 \"$g\" --claude-hook || true"
          }
        ]
      }
    ]
  }
}
