{
 "about": "Golden cases for a machine's card and for item fit (server-spec/machine-fit.md; checks MF1 and MF2). Card cases give a card and expect ok and the named fields. Fit cases give a valid card, an item's needs, and an optional speed_factor, and expect fits and the exact reasons.",
 "card_cases": [
  {
   "name": "valid",
   "what": "a full card is accepted",
   "card": {
    "graphics_gb": 8,
    "free_storage_gb": 200,
    "tools": [
     "voice",
     "ffmpeg"
    ],
    "speed_minutes": 45
   },
   "expect": {
    "ok": true,
    "fields": []
   }
  },
  {
