        "EXP-1",
        "EXP-2",
        "EXP-3",
        "BM-1",
        "FINDING-F1"
      ],
      "prefixes": [
        "FINDING-"
      ],
      "records": [
        {
          "event": "link",
          "from": "EXP-2",
          "to": "EXP-1",
          "kind": "refines",
          "why": "w"
        }
      ],
      "expect": {
        "related": {
          "EXP-2": [
            "refines EXP-1"
          ],
          "EXP-1": [
            "refined-by EXP-2"
          ]
        },
        "blocked_by": {},
        "refused": []
      }
    },
